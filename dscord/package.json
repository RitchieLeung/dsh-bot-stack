{
  "name": "dscord",
  "version": "0.4.0-alpha.2",
  "type": "module",
  "license": "Apache-2.0",
  "description": "DSCord collaboration server and independent Bot nodes, with a prebuilt chat PWA",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "main": "./dsh-connect/index.mjs",
  "exports": {
    ".": "./dsh-connect/index.mjs",
    "./client": "./dsh-connect/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "bin": {
    "dscord": "bin/dscord.mjs"
  },
  "files": [
    "bin",
    "src",
    "memory",
    "service/ombre",
    "scripts",
    "web/mention-tokens.js",
    "dist/web",
    "dist/admin",
    "deploy/synapse",
    "dsh-plugin",
    "dsh-connect",
    "cordis.patch.yml",
    "vendor/ds-bot",
    "模型配置与迁移.md",
    "LICENSE",
    "NOTICE"
  ],
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@modelcontextprotocol/client": "2.4.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "deep-view": "0.1.2",
    "highlight.js": "11.12.0",
    "imapflow": "2.9.1",
    "lucide": "1.68.0",
    "lucide-react": "1.68.0",
    "mailparser": "3.12.4",
    "nodemailer": "10.2.1",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-cjk-friendly": "2.3.3",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.7.0",
    "web-push": "3.6.7",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MixGeekers/dscord.git",
    "directory": "apps/ds-group"
  },
  "homepage": "https://github.com/MixGeekers/dscord",
  "bugs": {
    "url": "https://github.com/MixGeekers/dscord/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "alpha"
  }
}
